# Copy this file to .env (same folder) and fill in real values.
# api.py loads this automatically via python-dotenv — no more `set` commands
# needed in every new terminal.

# Must match PYTHON_SERVICE_SECRET in the Next.js app's .env.local exactly.
PYTHON_SERVICE_SECRET=pick-any-long-random-string-yourself

# Required by llm_provider.py — get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── Optional: file uploads (stored on local disk by the backend) ─────────────
# MAX_UPLOAD_MB=200              # largest accepted upload
# LOCAL_UPLOAD_TTL_HOURS=24      # uploaded files are deleted after this long
# LOCAL_UPLOAD_DIR=              # default: <system temp dir>/ast_uploads

# ── Optional: model overrides and a fallback provider ────────────────────────
# GROQ_CODE_MODEL=openai/gpt-oss-20b
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible /chat/completions endpoint; used only if Groq fails.
# FALLBACK_LLM_BASE_URL=https://api.openai.com/v1
# FALLBACK_LLM_API_KEY=
# FALLBACK_CODE_MODEL=
# FALLBACK_CHAT_MODEL=

# ── Optional: daily cap on real LLM calls, across all users ──────────────────
# Protects your Groq quota on a public demo. Resets 00:00 UTC. 0 = no cap.
# LLM_DAILY_CALL_LIMIT=400

# ── Reverse proxies in front of this service ─────────────────────────────────
# Used to read the real caller address from X-Forwarded-For (counted from the right).
# Render = 1, local dev with no proxy = 0. Never leave it at 1 when nothing sits in front.
# TRUSTED_PROXY_HOPS=1   # default: 1 when RENDER or APP_ENV=production is set, otherwise 0 (ignore X-Forwarded-For)

# Set to "production" on any host that does not set RENDER, so a stray .env file
# cannot override the platform's real environment variables.
# APP_ENV=production

# ── Optional: import a whole Google Drive FOLDER (Join Datasets -> Google Drive) ─
# With a key, the folder is listed through the official Drive API. Without one, a best-effort fallback reads the folder's
# public embedded view. Either way the folder must be shared "Anyone with the link" (Viewer); private folders stay private.
# Get a key: console.cloud.google.com -> create/select a project -> APIs & Services -> enable "Google Drive API" ->
# Credentials -> Create credentials -> API key. Keep it in this file only; it is never sent to the browser.
# GOOGLE_API_KEY=
# DRIVE_FOLDER_MAX_FILES=12      # most files imported from one folder (1-50)
# DRIVE_IMPORT_BUDGET_S=90       # give up on the remaining files of one import after this many seconds
