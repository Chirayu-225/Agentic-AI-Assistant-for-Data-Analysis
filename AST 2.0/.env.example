# Copy this file to .env (same folder) and fill in real values.
# api.py loads this automatically via python-dotenv — no more `set` commands
# needed in every new terminal.

# Must match PYTHON_SERVICE_SECRET in the Next.js app's .env.local exactly.
PYTHON_SERVICE_SECRET=pick-any-long-random-string-yourself

# Required by llm_provider.py — get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
