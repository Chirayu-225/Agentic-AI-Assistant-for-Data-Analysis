# Copy this file to .env (same folder) and fill in real values.
# api.py loads this automatically via python-dotenv — no more `set` commands
# needed in every new terminal.

# Must match PYTHON_SERVICE_SECRET in the Next.js app's .env.local exactly.
PYTHON_SERVICE_SECRET=pick-any-long-random-string-yourself

# Required by llm_provider.py — get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── Optional: file uploads (stored on local disk by the backend) ─────────────
# MAX_UPLOAD_MB=200              # largest accepted upload
# LOCAL_UPLOAD_TTL_HOURS=24      # uploaded files are deleted after this long
# LOCAL_UPLOAD_DIR=              # default: <system temp dir>/ast_uploads

# ── Optional: model overrides and a fallback provider ────────────────────────
# GROQ_CODE_MODEL=openai/gpt-oss-20b
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible /chat/completions endpoint; used only if Groq fails.
# FALLBACK_LLM_BASE_URL=https://api.openai.com/v1
# FALLBACK_LLM_API_KEY=
# FALLBACK_CODE_MODEL=
# FALLBACK_CHAT_MODEL=

# ── Optional: daily cap on real LLM calls, across all users ──────────────────
# Protects your Groq quota on a public demo. Resets 00:00 UTC. 0 = no cap.
# LLM_DAILY_CALL_LIMIT=400
