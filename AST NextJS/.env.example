# Copy this file to .env.local (same folder) and fill in the values.
# That is all the frontend needs — no storage account, no tokens.
# (ACCESS_CODE below is optional locally, required in production.)

# Where the Python (FastAPI) backend is running.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Must match PYTHON_SERVICE_SECRET in "AST 2.0/.env" exactly.
PYTHON_SERVICE_SECRET=pick-any-long-random-string-yourself

# Access code visitors must enter before using the app. Keeps strangers
# from spending your Groq quota. Optional in local dev (gate is off when
# unset); REQUIRED in production — without it the deployed app stays locked.
ACCESS_CODE=choose-a-code-to-share-with-reviewers
